{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "data": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/refresh",
      "schedule": "7 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/status",
      "destination": "/api/status-page"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.rightwindow.nyc"
        }
      ],
      "destination": "https://rightwindow.nyc/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "rightwindow.vercel.app"
        }
      ],
      "destination": "https://rightwindow.nyc/:path*",
      "permanent": true
    }
  ]
}
