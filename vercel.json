{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "data": false
    }
  },
  "rewrites": [
    {
      "source": "/status",
      "destination": "/status.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.rightwindow.nyc"
        }
      ],
      "destination": "https://rightwindow.nyc/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "rightwindow.vercel.app"
        }
      ],
      "destination": "https://rightwindow.nyc/:path*",
      "permanent": true
    }
  ]
}
